# Dev mode: symlinks to local repos (dev-mode.sh / submodule-mode.sh)
# These paths are either real submodules OR symlinks — git tracks submodule pointer, not the symlink itself.
# The .dev-mode-pins file records the commit SHA to restore when switching back.
.dev-mode-pins
*.sh
!tools/ci/*.sh
dependencies.lock
