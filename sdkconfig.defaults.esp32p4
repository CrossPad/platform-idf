CONFIG_IDF_TARGET="esp32p4"

# Flash — P4 Function EV Board has 16MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb_p4.csv"
# P4 bootloader is larger than S3 — move partition table to 0x9000
CONFIG_PARTITION_TABLE_OFFSET=0x9000

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

CONFIG_LWIP_TCP_SACK_OUT=y

# 200MHz PSRAM requires experimental features flag
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# Override base S3 PSRAM settings
# CONFIG_SPIRAM_MODE_OCT is not set
# CONFIG_SPIRAM_SPEED_80M is not set
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# L2 Cache — larger cache + line size improves PSRAM throughput for DSI
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# Note: CONFIG_LCD_DSI_ISR_IRAM_SAFE requires all DSI callbacks in IRAM.
# esp_lvgl_port v2.7.2 does NOT mark lvgl_port_flush_dpi_panel_ready_callback
# with IRAM_ATTR, so enabling this causes registration failure and deadlock.
# Re-enable after esp_lvgl_port is patched.
# CONFIG_LCD_DSI_ISR_IRAM_SAFE is not set
CONFIG_GDMA_ISR_IRAM_SAFE=y

# Compiler optimization for speed
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESP_WIFI_REMOTE_LIBRARY_EPPP=y
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_SERVER_SUPPORT=y
CONFIG_LWIP_PPP_VJ_HEADER_COMPRESSION=n

# Display — double-buffered DPI with full refresh for smooth LVGL
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_BSP_DISPLAY_LVGL_FULL_REFRESH=y

# LVGL graphical acceleration
CONFIG_LV_USE_PPA=y