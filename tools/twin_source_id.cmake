# The twin's source id: one hash of everything the board's firmware and its browser
# twin (crosspad-web-twin) both compile into the screen. The board answers it to
# TWIN_HELLO, the twin carries its own (crosspad-pc wasm_bridge.cpp); when they differ
# the twin was built from other sources than the board was flashed from, and says so
# instead of drifting quietly. docs/subsystems/twin-protocol.md.
#
#   cmake -DFW=<platform-idf checkout> -DOUT=<generated .c> [-DDUMP=<file>] -P tools/twin_source_id.cmake
#
# Both builds run it on every build (sources change without a reconfigure); it rewrites
# OUT only when the id changed. It hashes the files themselves, not git's view of them:
# the same sources give the same id from any clone, worktree or tarball, committed or
# not, and an app installed beside the firmware (no repository) counts like any other.
# Only what is compiled: C/C++ sources and headers, CMake files; not docs, tests, host
# tools, hidden dirs (a stray review file must not make a twin "wrong"). What goes in:
#   * every components/crosspad-* with a CMakeLists.txt, except crosspad-platform-idf
#     (the board's own layer, not in the twin);
#   * main/app/settings, main/app/update (built into the twin), main/include/twin_state.h,
#     main/idf_component.yml (the LVGL version); the fonts are crosspad-gui's;
#   * apps.json (which apps the build registers).
# Board-only code (drivers, the mirror itself) is not in it: a change there needs no new
# twin. The protocol has its own number (twin_state.h kProtocol). -DDUMP writes what was
# hashed, to see why two ids differ (diff the two dumps).
cmake_minimum_required(VERSION 3.16)
if(NOT FW OR NOT OUT)
  message(FATAL_ERROR "twin_source_id.cmake: -DFW=<platform-idf> -DOUT=<file.c>")
endif()

set(_roots "")
file(GLOB _dirs LIST_DIRECTORIES true "${FW}/components/crosspad-*")
list(FILTER _dirs EXCLUDE REGEX "/crosspad-platform-idf$")
foreach(_d ${_dirs})
  if(EXISTS "${_d}/CMakeLists.txt")                   # an uninitialized submodule is not built
    file(RELATIVE_PATH _r "${FW}" "${_d}")
    list(APPEND _roots "${_r}")
  endif()
endforeach()
list(APPEND _roots main/app/settings main/app/update main/include/twin_state.h
                   main/idf_component.yml apps.json)
list(SORT _roots)

set(_acc "")
foreach(_r ${_roots})
  set(_p "${FW}/${_r}")
  if(IS_DIRECTORY "${_p}")
    file(GLOB_RECURSE _files RELATIVE "${FW}" "${_p}/*")
    # what is compiled: code and its build files, not docs, tests, tools or hidden dirs
    list(FILTER _files INCLUDE REGEX "(\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|inc|ipp|cmake)|/CMakeLists\\.txt)$")
    list(FILTER _files EXCLUDE REGEX "(^|/)(\\.[^/]*|tests?|docs?|tools|host|examples?)/")
    list(SORT _files)
  elseif(EXISTS "${_p}")
    set(_files "${_r}")
  else()
    set(_files "")
  endif()
  foreach(_f ${_files})
    file(SHA256 "${FW}/${_f}" _fh)
    string(APPEND _acc "${_f} ${_fh}\n")
  endforeach()
endforeach()

if(DUMP)
  file(WRITE "${DUMP}" "${_acc}")
endif()
string(SHA256 _h "${_acc}")
string(SUBSTRING "${_h}" 0 12 _id)
set(_src "/* Generated by tools/twin_source_id.cmake: what the screen is built from. */\nconst char *const twin_source_id = \"${_id}\";\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
else()
  set(_old "")
endif()
if(NOT _old STREQUAL _src)
  get_filename_component(_dir "${OUT}" DIRECTORY)
  file(MAKE_DIRECTORY "${_dir}")
  file(WRITE "${OUT}" "${_src}")
  message(STATUS "twin source id ${_id}")
endif()
