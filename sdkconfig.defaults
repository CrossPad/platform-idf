# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#

# Target
CONFIG_IDF_TARGET="esp32s3"

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Memory
CONFIG_SPIRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# The board has 16 MB of flash (partitions_16mb.csv); sdkconfig.v1/v2 and
# sdkconfig.defaults.esp32s3 say the same.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_PERF=y

# Filesystem
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=127
# The card holds kit folders and sample files named by whoever made them, and
# the default ANSI/OEM API encoding hands those back transcoded to code page
# 437, which has no Polish (or German, or Czech) letters: the name comes out
# with '?' where the diacritics were and the path can no longer be opened.
# UTF-8 is what the rest of the firmware speaks, LVGL included.
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_FS_LOCK=32
CONFIG_FATFS_VOLUME_COUNT=3
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

# The native sampler engine plays every kit; the prebuilt streamer is compiled
# out (components/crosspad-platform-idf/Kconfig). Set it to y for an A/B image
# with both engines and SMPL_ENGINE native|marcel.
# CONFIG_CROSSPAD_SAMPLER_MARCEL is not set

CONFIG_UART_ISR_IN_IRAM=y

# TinyUSB Configuration
# MSC is the USB transfer profile (docs/subsystems/usb-transfer-mode.md). The
# buffer is CFG_TUD_MSC_EP_BUFSIZE, a static allocation inside the class driver
# that costs its size in internal RAM in every profile — four sectors is more
# than a full-speed bulk link can keep busy.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=2048
CONFIG_TINYUSB_MIDI_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_RHPORT_FS=y
CONFIG_TINYUSB_MODE_DMA=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=128
CONFIG_TINYUSB_CDC_TX_BUFSIZE=256
# No TinyUSB log: level 1 prints ~16 lines through esp_rom_printf at every
# enumeration and stream open, and costs ~2.2 kB of .flash.text, which v2 does
# not have to spare below the 0x421F0000 page. Set 1 to see TU_ASSERT failures.
CONFIG_TINYUSB_DEBUG_LEVEL=0

# USB Device Descriptor
CONFIG_TINYUSB_DESC_BCD_DEVICE=0x0100
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Espressif Systems"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Crosspad"
CONFIG_TINYUSB_DESC_CDC_STRING="Crosspad CDC Device"

# FreeRTOS Configuration
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y
CONFIG_FREERTOS_HZ=1000

# FreeRTOS Performance Profiling (Phase 3: Stack Reduction)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Common ESP-related
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048

# WiFi — reduced buffers for ESP-NOW (point-to-point, low throughput)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=0
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6

# Display — reduced draw buffer height to save ~45KB SRAM (320×30×2=19KB vs 320×100×2=64KB)
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=30

# LVGL Configuration
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_PERF_MONITOR_ALIGN_TOP_RIGHT=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_COLOR_DEPTH_24=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_OBSERVER=y
# SCREENSHOT over CDC (hil_control.cpp): the screen as a BMP on the card.
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_ASSERT_HANDLER_INCLUDE="lvgl_assert_handler.h"
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_FS_POSIX_LETTER=65
CONFIG_LV_FS_DEFAULT_DRIVER_LETTER=65
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_LOG_LEVEL=3
CONFIG_LV_CACHE_DEF_SIZE=196608
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=16

# Bootloader — WARN: the DEBUG bootloader flood costs UART time at every boot
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2

# App rollback: a freshly switched-to OTA slot boots on trial and confirms
# itself (fw_slots.h, fw_confirm_running()) — the bootloader returns to the
# previous slot on its own if it never does. PROJECT_VER travels with it:
# fw_rollback_supported() reads it back from the bootloader's own descriptor
# to know whether the flashed bootloader can actually roll back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_PROJECT_VER=2

# Security
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set

# Memory Safety
# Heap Poisoning disabled — saves ~16 KB SRAM (12 bytes/alloc overhead on ~800 blocks)
# Re-enable for debugging: CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_HEAP_POISONING_LIGHT=y

# Hardware Stack Guard - Use CPU watchpoints to detect stack overflows
CONFIG_ESP_SYSTEM_HW_STACK_GUARD=y

# Assertions - Enable runtime checks
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Additional safety checks
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=1

CONFIG_DSP_OPTIMIZED=y
# The pitched instrument's load-time resampler runs an 8192-point inverse FFT
# (4096 block, spectrally zero-padded 2x). The choice lives here because a
# choice in sdkconfig.defaults wins over the per-revision sdkconfig files.
CONFIG_DSP_MAX_FFT_SIZE_8192=y

# USB Audio Class (UAC2) Configuration
CONFIG_USB_DEVICE_UAC_AS_PART=y
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_SPK_INTERVAL_MS=10
# 5 ms rather than 10: this sets both the mic task's granularity and, through
# EP_IN_SW_BUF_SZ in usb_device_uac's header, part of the capture path. Measured
# in a DAW against the MIDI note that triggered the pad, the recorded offset went
# 21 ms -> 12 ms. Shorter is not better -- 3 ms measured 40 ms and 2 ms measured
# 61 ms -- so do not extrapolate this value, measure it.
CONFIG_UAC_MIC_INTERVAL_MS=5
CONFIG_UAC_SPK_NEW_PLAY_INTERVAL=100
# Full-speed feedback as 10.14 instead of 16.16. Without it macOS answers every
# feedback packet with a babble error on EP 0x82 -- 80/s, stream throughput down
# to 41 % -- because a full-speed feedback endpoint takes 3 bytes, not 4.
# NOTE: TinyUSB's own table in audiod_fb_send() lists OSX only on the 10.14 rows
# and Windows only on 16.16/4/4, so a Windows bench should confirm this. USB
# Audio 2.0 specifies 10.14 for full speed, which is why it is on by default.
CONFIG_UAC_SUPPORT_MACOS=y
# Above the card workers (tools_io, song_io, kit_load are 5) and the UI: the
# speaker task alone keeps host playback's ring filled, and the ring holds
# ~16 ms. Below audio_bg (18) and audio_rt (19); a wake is one packet's copy.
CONFIG_UAC_SPK_TASK_PRIORITY=15
CONFIG_UAC_SPK_TASK_CORE=-1
CONFIG_UAC_MIC_TASK_PRIORITY=15
CONFIG_UAC_MIC_TASK_CORE=-1

# Black box: panic/task-WDT leave an ELF core dump in the coredump partition
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_TASK_WDT_PANIC=y

# Heap tracing on demand (HEAP_TRACE over CDC); costs nothing until started
CONFIG_HEAP_TRACING_STANDALONE=y
CONFIG_HEAP_TRACING_STACK_DEPTH=4

# ULP RISC-V coprocessor: background work off the main CPU (bsp_ulp.h)
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_RISCV=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096
